{
  "name": "@repo/store",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./drivers/web": "./src/drivers/web.ts",
    "./drivers/native": "./src/drivers/native.ts",
    "./testing": "./test/node-sqlite-driver.ts"
  },
  "scripts": {
    "typecheck": "tsc7 --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage",
    "migrations:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.registry.config.ts && node scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/schema": "workspace:*",
    "@repo/util": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-secure-store": "*",
    "expo-sqlite": "*",
    "sqlocal": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "sqlocal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "playwright": "^1.61.1",
    "sqlocal": "^0.18.0",
    "vitest": "catalog:"
  }
}
