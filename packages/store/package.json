{
  "name": "@repo/store",
  "version": "0.0.1",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./drivers/web": "./src/drivers/web.ts",
    "./drivers/native": "./src/drivers/native.ts",
    "./testing": "./test/node-sqlite-driver.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrations:generate": "drizzle-kit generate --config drizzle.config.ts && node scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/schema": "workspace:*",
    "@repo/util": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "peerDependencies": {
    "expo-secure-store": "*",
    "expo-sqlite": "*",
    "sqlocal": "*"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "sqlocal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "vitest": "catalog:"
  }
}
