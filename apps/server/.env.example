REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production (docker-compose.prod.yml); empty = no auth
REDIS_PASSWORD=
REGISTRATION_DISABLED=
PREFIX=/trpc

# OPAQUE (cloudflare opaque-ts). Generate with:
#   bun apps/server/scripts/opaque-cf-bootstrap.ts
OPAQUE_OPRF_SEED=
OPAQUE_AKE_PRIVATE_KEY=
# Legacy: still used as the HMAC/encryption key for email hashing & email-at-rest.
OPAQUE_SERVER_SETUP=

# Exact origin(s) the web app is served from, comma-separated (e.g. https://pass.example.com).
# Required in production; empty in development = localhost:5173 / 4173 / 8080
CORS_ORIGIN=

# Log level: trace|debug|info|warn|error|fatal (default: info in prod, debug in dev)
LOG_LEVEL=

# Storage per vault owner in MB, record history included (default: 100)
STORAGE_QUOTA_MB=
