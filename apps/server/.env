# Exact origin(s) the web app is served from, comma-separated (e.g. https://pass.example.com).
# Required in production; empty in development = localhost:5173 / 4173 / 8080
CORS_ORIGIN=

# PostgreSQL Database
DATABASE_URL=postgres://passmgr:passmgr123@localhost:5432/passmgr

# Log level: trace|debug|info|warn|error|fatal (default: info in prod, debug in dev)
LOG_LEVEL=

# Storage per vault owner in MB, record history included (default: 100)
STORAGE_QUOTA_MB=
# Email verification codes over SMTP; unset = no verification.
# Dev: Mailpit from `pnpm db:up` (UI http://localhost:8025): SMTP_URL=smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="passmgr <noreply@localhost>"
