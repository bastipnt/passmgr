#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="02af78adc748561bbc76e0caad3cc20e68b7835ff80ec851349b619bc0e3db413c"

# .env
REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production (docker-compose.prod.yml); empty = no auth
REDIS_PASSWORD=
REGISTRATION_DISABLED=
PREFIX=/trpc

# OPAQUE (cloudflare opaque-ts). Generate with:
#   bun apps/server/scripts/opaque-cf-bootstrap.ts
OPAQUE_OPRF_SEED=encrypted:BO7AVY31UOu+DnO3tAnOPKggxIJ91DiRI8dPMd8T3UQ6y302zn1Fricywq9i9CJ6VNsrAqSfuSDt73BsKBqXWWTQS/6wzEJ7TXoHncascrnvL345hh+xOtK70iDuIfnoxSqZ6nUV+VWtHzg2x7/bUPRUOh6qN+WG+WgEfzu50kzR48bafocHhX31HZxq
