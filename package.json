{
  "name": "passmgr",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform password manager built on OPAQUE zero-knowledge auth. Early prototype, not production-ready.",
  "license": "AGPL-3.0-only",
  "author": "Basti <bastipnt@posteo.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bastipnt/passmgr.git"
  },
  "bugs": {
    "url": "https://github.com/bastipnt/passmgr/issues"
  },
  "homepage": "https://github.com/bastipnt/passmgr#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:up": "turbo run db:up",
    "db:generate": "pnpm run --filter @repo/db db:generate",
    "db:migrate": "pnpm run --filter @repo/db db:migrate",
    "db:seed": "pnpm run --filter @repo/db db:seed",
    "lint": "turbo run lint",
    "format": "biome check --write",
    "format:check": "biome check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:integration:coverage": "turbo run test:integration:coverage",
    "e2e": "turbo run e2e",
    "e2e:ui": "turbo run e2e:ui",
    "typegen:css": "turbo run typegen:css",
    "storybook": "turbo run storybook",
    "build:storybook": "turbo run build:storybook",
    "stryker:crypto": "stryker run stryker.crypto.config.mjs",
    "stryker:store": "stryker run stryker.store.config.mjs",
    "stryker:server-auth": "stryker run stryker.server-auth.config.mjs",
    "stryker:client": "stryker run stryker.client.config.mjs",
    "fallow": "fallow"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "fallow": "^2.104.0",
    "turbo": "^2.10.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=18"
  }
}
