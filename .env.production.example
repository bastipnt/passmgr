# Copy to $DEPLOY_PATH/.env.production on the server. Never commit the real file.

# GitHub user/org owning the GHCR images (lowercase).
GHCR_OWNER=your-github-username
# Public hostname; the host Caddy (caddy-docker-proxy) routes it to the web container.
PUBLIC_HOSTNAME=pass.example.com
# Image tag to deploy. Overridden per-deploy by CI; "latest" is a sane local default.
IMAGE_TAG=latest

POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=passmgr

# OPAQUE server secrets. Generate once with:
#   bun apps/server/scripts/opaque-cf-bootstrap.ts
# Back them up offline — losing or rotating any of them invalidates all accounts.
OPAQUE_OPRF_SEED=
OPAQUE_AKE_PRIVATE_KEY=
OPAQUE_SERVER_IDENTITY=passmgr
# HMAC/encryption key for email hashing & email-at-rest. Generate with:
#   openssl rand -base64 32
OPAQUE_SERVER_SETUP=

# Public origin. Defaults to https://$PUBLIC_HOSTNAME.
# CORS_ORIGIN=
REGISTRATION_DISABLED=true
LOG_LEVEL=info
# Number of reverse proxies in front of the server (web Caddy + host Caddy).
TRUST_PROXY=2
