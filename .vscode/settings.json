{
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // "eslint.format.enable": true,
  // "eslint.lintTask.enable": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "cSpell.words": ["biome", "biomejs", "fastify", "oxlint", "oxlintrc", "trpc"],
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.useSortedProperties.biome": "explicit"
  },
  "editor.formatOnSave": true,
  "oxc.typeAware": true,
  "editor.defaultFormatter": "biomejs.biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // *.css is associated with the `tailwindcss` language id (see files.associations)
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.css.d.ts": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName",
    "contentContainerClassName",
    "columnWrapperClassName",
    "endFillColorClassName",
    "imageClassName",
    "tintColorClassName",
    "ios_backgroundColorClassName",
    "thumbColorClassName",
    "trackColorOnClassName",
    "trackColorOffClassName",
    "selectionColorClassName",
    "cursorColorClassName",
    "underlineColorAndroidClassName",
    "placeholderTextColorClassName",
    "selectionHandleColorClassName",
    "colorsClassName",
    "progressBackgroundColorClassName",
    "titleColorClassName",
    "underlayColorClassName",
    "colorClassName",
    "drawerBackgroundColorClassName",
    "statusBarBackgroundColorClassName",
    "backdropColorClassName",
    "backgroundColorClassName",
    "ListFooterComponentClassName",
    "ListHeaderComponentClassName"
  ],
  "tailwindCSS.classFunctions": ["cn", "cva", "useResolveClassNames"]
  // "tailwindCSS.experimental.configFile": {
  //   "apps/mobile/src/global.css": "apps/mobile/src/**",
  //   "packages/ui/src/styles/globals.css": "apps/web/src/**"
  // }
}
