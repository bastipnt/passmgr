{
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  // "eslint.format.enable": true,
  // "eslint.lintTask.enable": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "cSpell.words": ["biome", "biomejs", "fastify", "oxlint", "oxlintrc", "trpc"],
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.useSortedProperties.biome": "explicit"
  },
  "editor.formatOnSave": true,
  "oxc.typeAware": true,
  "editor.defaultFormatter": "biomejs.biome",
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  // *.css is associated with the `tailwindcss` language id (see files.associations)
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.css.d.ts": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName",
    "contentContainerClassName",
    "columnWrapperClassName",
    "endFillColorClassName",
    "imageClassName",
    "tintColorClassName",
    "ios_backgroundColorClassName",
    "thumbColorClassName",
    "trackColorOnClassName",
    "trackColorOffClassName",
    "selectionColorClassName",
    "cursorColorClassName",
    "underlineColorAndroidClassName",
    "placeholderTextColorClassName",
    "selectionHandleColorClassName",
    "colorsClassName",
    "progressBackgroundColorClassName",
    "titleColorClassName",
    "underlayColorClassName",
    "colorClassName",
    "drawerBackgroundColorClassName",
    "statusBarBackgroundColorClassName",
    "backdropColorClassName",
    "backgroundColorClassName",
    "ListFooterComponentClassName",
    "ListHeaderComponentClassName"
  ],
  "tailwindCSS.classFunctions": ["cn", "cva", "useResolveClassNames"],
  /*
   * Two Tailwind v4 entry points live in this monorepo. Without an explicit
   * map the extension auto-detects both and serves whichever it found first,
   * so mobile-only tokens (--spacing-md, px-based --text-*) leak into web
   * files and vice versa. Keys = entry CSS, values = globs (relative to the
   * workspace root) of files that resolve against that entry.
   *
   * NOTE: once this setting exists, files matched by NO glob get no
   * IntelliSense at all — add new UI dirs here.
   */
  "tailwindCSS.experimental.configFile": {
    "packages/ui/src/styles/globals.css": [
      "apps/web/src/**",
      "packages/ui/src/**",
      "packages/ui-shared/src/**"
    ],
    "apps/mobile/src/global.css": ["apps/mobile/src/**", "packages/ui-native/src/**"]
  },
  "tailwindCSS.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/.stryker-tmp/**",
    "**/.turbo/**"
  ]
}
